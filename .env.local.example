# Optional: set this to the final HTTPS origin after connecting a domain.
# Used for absolute metadata URLs; omit it during local development.
NEXT_PUBLIC_SITE_URL=

# The current homepage uses local assets and does not use Google Map Tiles.
# Leave this disabled unless you intentionally deploy the optional flight view.
# Google Map Tiles requires a configured Google Cloud project and may incur charges.
NEXT_PUBLIC_GOOGLE_TILES_ENABLED=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Never commit .env.local. NEXT_PUBLIC_ values are exposed to visitors' browsers.
